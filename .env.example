# ==== LLM & Embedding APIs ====
OPENAI_API_KEY=          # GPT-4o-mini: metadata extraction, query rewriting, Ragas eval
ANTHROPIC_API_KEY=       # Claude: generation chính (nếu dùng thay OpenAI)
GROQ_API_KEY=            # Llama 3 qua Groq: route cho câu hỏi đơn giản, tối ưu tốc độ/chi phí

# ==== Embedding model (BGE-M3 chạy local, thường không cần key) ====
HF_TOKEN=                # chỉ cần nếu model gated hoặc muốn tải nhanh hơn

# ==== Database (local qua docker-compose, để trống nếu dùng cloud) ====
MONGO_USER=admin
MONGO_PASSWORD=changeme
# MONGO_URI=             # điền nếu chuyển sang MongoDB Atlas (cloud)
# QDRANT_URL=            # điền nếu chuyển sang Qdrant Cloud
# QDRANT_API_KEY=        # điền nếu chuyển sang Qdrant Cloud