import csv
import json
import os
import sys

from config import DATA_DIR, CSV_FILENAME, JSON_FILENAME

# ==========================================
# CHUYỂN ĐỔI CSV SANG JSON
# ==========================================

def convertJson():
    """Chuyển đổi dữ liệu từ CSV sang JSON"""
    print("\n--- Step 3: Convert CSV to JSON ---")
    
    if not os.path.exists(CSV_FILENAME):
        print(f'[!] CSV file is not found: {CSV_FILENAME}')
        return False
    
    try:
        json_data = []

        with open(CSV_FILENAME, mode='r', encoding='utf-8-sig') as f:
            reader = csv.DictReader(f)
            for row in reader:
                record = {
                    "Company": row['Company'],
                    "Key_Original": row['Key_Original'],
                    "New_File_Name": row['NewFileName'].strip()
                }
                json_data.append(record)
        
        # Tạo thư mục nếu chưa tồn tại
        json_dir = os.path.dirname(JSON_FILENAME)
        os.makedirs(json_dir, exist_ok=True)
        
        with open(JSON_FILENAME, mode='w', encoding='utf-8-sig') as f:
            json.dump(json_data, f, ensure_ascii=False, indent=4)
        
        print(f" [OK] Converted {len(json_data)} records to JSON")
        print(f" [OK] Save in: {JSON_FILENAME}")
        return True
        
    except Exception as e:
        print(f" [!] Convert Error: {e}")
        return False

# ==========================================
# ENTRY POINT
# ==========================================

if __name__ == "__main__":
    print("="*60)
    print("Step 3: Convert CSV to JSON")
    print("="*60)
    
    success = convertJson()
    
    if success:
        print(f"\n JSON file is created at: {JSON_FILENAME}")
        sys.exit(0)
    else:
        print("\n[!] Conver Error")
        sys.exit(1)
