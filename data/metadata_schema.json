{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FinancialDocumentMetadata",
  "type": "object",
  "properties": {
    "document_id": { "type": "string", "description": "Mã định danh duy nhất của file" },
    "company": { "type": "string", "description": "Tên đầy đủ của công ty" },
    "ticker": { "type": "string", "description": "Mã chứng khoán (FPT, AAPL...)" },
    "country": { "type": "string", "enum": ["VN", "US"], "description": "Quốc gia" },
    "industry": { "type": "string", "description": "Ngành nghề kinh doanh" },
    "document_type": { "type": "string", "enum": ["10-K", "10-Q", "BCTC_Nam", "BCTC_Quy", "Ban_Cao_Bach", "Hop_Dong_Tin_Dung"], "description": "Loại tài liệu" },
    "year": { "type": "integer", "description": "Năm tài chính" },
    "quarter": { "type": ["integer", "null"], "description": "Quý (nếu có, nếu là báo cáo năm thì để null)" },
    "language": { "type": "string", "enum": ["vi", "en"], "description": "Ngôn ngữ sử dụng" },
    "source": { "type": "string", "description": "Nguồn thu thập (SEC_EDGAR, Cafef...)" },
    "file_name": { "type": "string", "description": "Tên file lưu trong thư mục raw" }
  },
  "required": ["document_id", "company", "ticker", "country", "document_type", "year", "language", "file_name"]
}