import os
import re
import time
import requests
from bs4 import BeautifulSoup
from urllib.parse import urljoin
from selenium import webdriver
from selenium.webdriver.chrome.options import Options
from selenium.webdriver.common.by import By

from config import TASKS, BASE_DOWNLOAD_DIR, HEADERS

# ==========================================
# 2. HÀM XỬ LÝ TIÊU ĐỀ
# ==========================================

def extract_clean_title(link_tag, default_href):
    """Lấy tiêu đề chống dính chữ và xóa từ rác"""
    # Tách các thẻ con bằng khoảng trắng để không dính chữ
    raw_title = link_tag.get_text(separator=" ", strip=True)
    if not raw_title:
        raw_title = default_href.split('/')[-1]
        
    # Danh sách từ rác thường nằm ở cuối tên file
    junk_words = ["Xem", "Tải về", "Download", "PDF", "Đã soát xét", "Đã soát xétkiểm toán"]
    
    for word in junk_words:
        if raw_title.lower().endswith(word.lower()):
            raw_title = raw_title[:-len(word)].strip()
            
    # Xóa ký tự cấm của hệ điều hành
    clean_name = re.sub(r'[\\/*?:"<>|]', "", raw_title)
    
    # Xóa khoảng trắng dư thừa
    clean_name = " ".join(clean_name.split())
    
    if not clean_name.lower().endswith(".pdf"):
        clean_name += ".pdf"
        
    return clean_name

# ==========================================
# 3. GIAI ĐOẠN 1: QUÉT DỮ LIỆU 
# ==========================================

def scan_files(tasks):
    print("\n" + "="*50 + "\n BẮT ĐẦU QUÉT DỮ LIỆU (SELENIUM)\n" + "="*50)
    total_files_found = 0
    
    # Cấu hình Selenium (thêm # trước --headless nếu bạn muốn xem trình duyệt tự click)
    chrome_options = Options()
    #chrome_options.add_argument("--headless") 
    driver = webdriver.Chrome(options=chrome_options)
    
    try:
        for task in tasks:
            print(f"\n[*] Đang quét công ty: {task['company']}")
            for url in task["urls"]:
                print(f"    -> Truy cập: {url}")
                driver.get(url)
                time.sleep(4) # Đợi trang web tải khung sườn
                
                # --- TRƯỜNG HỢP A: WEB CẦN CLICK CHỌN NĂM (Ví dụ: MWG) ---
                if task["click_years"]:
                    for year in task["click_years"]:
                        print(f"       + Đang giả lập click chọn năm: {year}")
                        try:
                            # Tìm thẻ bất kỳ chứa chữ của năm đó
                            xpath = f"//*[text()='{year}' or contains(text(), ' {year}')]"
                            btn = driver.find_element(By.XPATH, xpath)
                            driver.execute_script("arguments[0].click();", btn)
                            
                            time.sleep(3) # Đợi AJAX tải danh sách mới về
                            
                            # Phân tích HTML hiện tại
                            soup = BeautifulSoup(driver.page_source, 'html.parser')
                            
                            # Cải tiến: Tìm mọi thẻ a có chứa ".pdf" trong href (linh hoạt hơn href$)
                            pdf_links = soup.find_all('a', href=re.compile(r'\.pdf', re.IGNORECASE))
                            
                            for link in pdf_links:
                                href = link.get('href')
                                full_url = urljoin(url, href)
                                file_name = extract_clean_title(link, href)
                                
                                # Chống trùng lặp
                                if not any(f['url'] == full_url for f in task["files_to_download"]):
                                    task["files_to_download"].append({"title": file_name, "url": full_url})
                                    total_files_found += 1
                                    
                        except Exception as e:
                            print(f"       [!] Không click được năm {year}")

                # --- TRƯỜNG HỢP B: WEB LOAD DỮ LIỆU SẴN (Ví dụ: VNM, HPG) ---
                else:
                    soup = BeautifulSoup(driver.page_source, 'html.parser')
                    pdf_links = soup.find_all('a', href=re.compile(r'\.pdf', re.IGNORECASE))
                    
                    for link in pdf_links:
                        href = link.get('href')
                        full_url = urljoin(url, href)
                        file_name = extract_clean_title(link, href)
                        
                        if not any(f['url'] == full_url for f in task["files_to_download"]):
                            task["files_to_download"].append({"title": file_name, "url": full_url})
                            total_files_found += 1
                            
    finally:
        driver.quit() # Đóng trình duyệt
        
    return tasks, total_files_found

# ==========================================
# 4. GIAI ĐOẠN 2: IN DANH SÁCH & XÁC NHẬN
# ==========================================

def display_and_confirm(tasks, total_files):
    if total_files == 0:
        print("\n[!] Không tìm thấy file PDF nào. Vui lòng kiểm tra lại cấu trúc web.")
        return False
        
    print(f"\n DANH SÁCH FILE CHUẨN BỊ TẢI (Tổng: {total_files} file)")
    for task in tasks:
        if task["files_to_download"]:
            print(f"\n+ Công ty: {task['company']} ({len(task['files_to_download'])} file)")
            for idx, f in enumerate(task["files_to_download"], 1):
                print(f"  {idx}. {f['title']}")
                
    confirm = input(f"\nBạn có muốn tải {total_files} file này? (y/n): ").strip().lower()
    return confirm == 'y'

# ==========================================
# 5. GIAI ĐOẠN 3: TẢI FILE BẰNG REQUESTS
# ==========================================

def download_files(tasks):
    print("\n" + "="*50 + "\n BẮT ĐẦU TẢI FILE\n" + "="*50)
    os.makedirs(BASE_DOWNLOAD_DIR, exist_ok=True)
        
    for task in tasks:
        if not task["files_to_download"]: 
            continue
            
        company_dir = os.path.join(BASE_DOWNLOAD_DIR, task["company"])
        os.makedirs(company_dir, exist_ok=True)
        print(f"\n[*] Đang xử lý tải cho: {task['company']}")
        
        for file_info in task["files_to_download"]:
            file_path = os.path.join(company_dir, file_info["title"])
            
            if os.path.exists(file_path):
                print(f"    [Bỏ qua] File đã tồn tại: {file_info['title']}")
                continue
                
            print(f"    -> Đang tải: {file_info['title']}")
            try:
                # Dùng requests để tải file nhanh hơn
                res = requests.get(file_info["url"], headers=HEADERS, timeout=15)
                if res.status_code == 200:
                    with open(file_path, 'wb') as f:
                        f.write(res.content)
                else:
                    print(f"    [!] Lỗi HTTP {res.status_code} khi tải.")
                
                time.sleep(0.5) # Khoảng nghỉ tránh spam server
            except Exception as e:
                print(f"    [!] Lỗi kết nối: {e}")
                
    print("\nHOÀN TẤT TOÀN BỘ QUÁ TRÌNH!")

